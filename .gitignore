# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude scheduler runtime lock
.claude/scheduled_tasks.lock

# typescript
*.tsbuildinfo
next-env.d.ts

# taste-skill + Claude Code workspace (local-only; .claude/skills is a junction to a
# shared skills library OUTSIDE the repo — Turbopack/Tailwind v4 source-crawl must not
# follow it, else it escapes the filesystem root and panics on globals.css).
.agents/
.claude/

# dev throwaway artifacts (verification screenshots, raw diff dumps, scratch scripts)
gitdiff.txt
docs/dev/
scripts/dev/

# QA smoke/crawl screenshots — large throwaway binaries (~100MB/run). The markdown
# reports in docs/qa/*.md stand alone; the PNGs they link are local-only verification.
docs/qa/**/*-shots/
dev3001.log

# Research scraper raw output (regenerated by scripts/research/*.mjs) — large
# throwaway competitor data (~900KB), not consumed by app code. Keep the script,
# not its dump.
docs/research/vexere-operators.json
docs/research/vexere-operators.md

# Office temp/lock files
~$*

# Business legal documents (contain author metadata and sensitive business data)
documentation/business/*.doc
documentation/business/*.docx

# One-off status reports (contain PII)
awake-status-report.md

# MCP server config (machine-local)
.mcp.json
.playwright-mcp/

# Root-level QA crawl artifacts (numbered screenshots/snapshots/logs)
[0-9][0-9]-*.png
[0-9][0-9]-*.md
[0-9][0-9]-*.log

# Loose landing/hero verification screenshots (scratch, regenerated on demand).
# Anchored with a leading / so they only match at the repo root - an unanchored
# `hero-*.png` would also swallow real assets under public/hero/.
/hero-*.png
/header-*.png
/navbar-*.png
/truststrip-*.png
/mockup-pass*.png
/pass1-*.png
/scan-*.png
/scan-*.jpg

# Personal logistics research notes (local-only; not part of the app)
xe-dau-keo-hop-tac-lien-he.txt

# ── Kho du lieu du lich (Da Lat va cac diem den sau) ─────────────────────────
# KHONG commit. Ly do la PII, khong phai dung luong:
#   documentation/tourism/  chua 416 so di dong VIET NAM THAT (375 + 41) cua ho
#   .tourism-data/          chua 14.328 so
# Voi ho kinh doanh nho (vuon dau mot nguoi, tiem thue xe may), "so doanh
# nghiep" CHINH LA so di dong ca nhan. Repo nay duoc chuyen cong khai trong luc
# /ship de lay CI mien phi, nen commit = cong bo. `.gitleaks.toml` da co luat
# bat dung mau nay; allowlist 14k so that la vo hieu hoa chinh luat do.
#
# Du lieu nam o .tourism-data/raw/ (o day, ben ngoai thu muc tam cua phien lam
# viec). Cach tai tao: xem scripts/tourism/README.md
.tourism-data/
documentation/tourism/

# Python bytecode
__pycache__/
*.pyc
