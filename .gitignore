# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude scheduler runtime lock
.claude/scheduled_tasks.lock

# typescript
*.tsbuildinfo
next-env.d.ts

# taste-skill + Claude Code workspace (local-only; .claude/skills is a junction to a
# shared skills library OUTSIDE the repo — Turbopack/Tailwind v4 source-crawl must not
# follow it, else it escapes the filesystem root and panics on globals.css).
.agents/
.claude/

# dev throwaway artifacts (verification screenshots, raw diff dumps, scratch scripts)
gitdiff.txt
docs/dev/
scripts/dev/

# QA smoke/crawl screenshots — large throwaway binaries (~100MB/run). The markdown
# reports in docs/qa/*.md stand alone; the PNGs they link are local-only verification.
docs/qa/**/*-shots/
dev3001.log

# Office temp/lock files
~$*

# Business legal documents (contain author metadata and sensitive business data)
documentation/business/*.doc
documentation/business/*.docx

# One-off status reports (contain PII)
awake-status-report.md

# MCP server config (machine-local)
.mcp.json
.playwright-mcp/

# Root-level QA crawl artifacts (numbered screenshots/snapshots/logs).
# NOTE: these patterns are intentionally unanchored so audit/NN-*.png etc. at
# depth are also swept. The one place numbered .md files are deliberately kept
# is the archived project-status snapshot, re-included below.
[0-9][0-9]-*.png
[0-9][0-9]-*.md
[0-9][0-9]-*.log
!docs/archive/current-status/**

# Loose landing/hero verification screenshots (scratch, regenerated on demand).
# Anchored with a leading / so they only match at the repo root - an unanchored
# `hero-*.png` would also swallow real assets under public/hero/.
/hero-*.png
/header-*.png
/navbar-*.png
/truststrip-*.png
/mockup-pass*.png
/pass1-*.png
/scan-*.png
/scan-*.jpg

# Personal logistics research notes (local-only; not part of the app)
xe-dau-keo-hop-tac-lien-he.txt

# ── Tourism KB (Da Lat + cac diem den sau) — SAN PHAM RIENG ──────────────────
# Ca tinh nang du lich nam trong tourism-kb/ (tach khoi app dat ve xe). Luat
# ignore theo LOAI cua no o `tourism-kb/.gitignore`: tourism-kb/{raw,wiki,output}
# deu KHONG commit vi chua ~14.328 so di dong Viet Nam THAT cua ho kinh doanh
# nho — repo nay chuyen cong khai trong luc /ship, nen commit = cong bo. Chi
# tourism-kb/code/ (script) duoc theo doi. Hai guard: tourism-kb/code/
# duong_dan_ra.py chan luc GHI, G8 trong scripts/audit/greppable-invariants.sh
# chan luc PUSH. Xem tourism-kb/CLAUDE.md.

# Anh chup ad-hoc + scratch do dac o goc repo (chua ten/dia chi/so dien thoai
# that, khong khop mau nao khac).
/scratch_out*.txt

# Anh chup kiem tra ad-hoc o thu muc goc. prod-e2e-1-qr.png la ma QR thanh toan
# tu mot lan chay e2e tren PROD, co the ma hoa so tai khoan that.
/prod-e2e-*.png
/mcp-*.png
/validate-*.png

# Python bytecode
__pycache__/
*.pyc
